// hippoclaw 検証用の設定。Discord も Matrix も繋がない。
// モデルは compose の HIPPOCLAW_MODEL で切り替える
{
  gateway: {
    mode: "local",
    bind: "loopback",
    port: 18789,
    auth: { mode: "token", token: "${OPENCLAW_GATEWAY_TOKEN}" },
  },

  models: {
    providers: {
      // 決定的なスタブ。sandbox/stub-model/server.mjs
      stub: {
        baseUrl: "http://stub:4000/v1",
        apiKey: "${STUB_API_KEY}",
        api: "openai-completions",
        models: [
          {
            id: "stub",
            name: "stub",
            api: "openai-completions",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 32000,
            maxTokens: 4000,
          },
        ],
      },
      // 検証専用の ollama（compose の profile: ollama）。/v1 を付けるとツール呼び出しが壊れる（上流ドキュメント）
      ollama: {
        baseUrl: "http://ollama:11434",
        apiKey: "${OLLAMA_API_KEY}",
        api: "ollama",
        models: [
          {
            // sandbox/ollama/provision.sh が作る。num_ctx 32768
            id: "gemma4:e2b-dev",
            name: "gemma4:e2b-dev",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 32768,
            maxTokens: 4096,
          },
        ],
      },
    },
  },

  agents: {
    defaults: {
      model: { primary: "${HIPPOCLAW_MODEL}" },
      workspace: "/home/node/workspace",
      skipBootstrap: true,
      heartbeat: { every: "0m" },
      models: {
        // 考えさせないと tool call を本文に書いてしまう。遅くてもここは切らない
        "ollama/gemma4:e2b-dev": { params: { thinking: "low" } },
      },
    },
  },

  // Tool Search の裏にツールを隠さない。小さいモデルは探しに行けない（本番の private と同じ判断）
  tools: {
    toolSearch: false,
    // 検証では記憶のツールだけを見せる。小さいモデルが web_search に流れるのを防ぐ
    allow: ["memory_search", "memory_get"],
  },

  plugins: {
    load: { paths: ["/home/node/plugins"] },
    // memory スロットを hippoclaw-memory に。memory-core は slot を取られると自動で disabled になる
    slots: { memory: "hippoclaw-memory" },
    entries: {
      "hippoclaw-memory": {
        enabled: true,
        config: {
          // 索引に入れるファイル。workspace 相対の glob。既定と同じ値を明示しておく
          include: ["MEMORY.md", "memory/*.md"],
          // memory_search が返す最大件数
          maxResults: 6,
        },
      },
      // slot を取られても memory-core は dreaming sidecar として残る。dreaming も要らないので丸ごと切る
      "memory-core": { enabled: false },
      // active-memory は純正のまま（未指定）。recall を書く時に切る
    },
  },
}
