{
  "id": "hippoclaw-memory",
  "name": "hippoclaw-memory",
  "description": "memory-core 相当。plugins.slots.memory を取り、許可リストで索引を作る",
  "kind": "memory",
  "categories": [
    "memory",
    "tools"
  ],
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "memory_search",
      "memory_get",
      "memory_append"
    ]
  },
  "toolMetadata": {
    "memory_append": {
      "optional": true,
      "sideEffecting": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "include": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "索引に入れるファイル。workspace 相対の glob",
        "default": [
          "MEMORY.md",
          "memory/*.md"
        ]
      },
      "exclude": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "索引から外すファイル。workspace 相対の glob。include より優先",
        "default": []
      },
      "maxResults": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "description": "memory_search が返す最大件数",
        "default": 6
      }
    }
  }
}
